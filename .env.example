# ============================================================
# TraceIQ Production Environment
# Copy to .env and fill in all values
# ============================================================

# Deployment: self-hosted installations are free and unrestricted. Only the
# TraceIQ-managed Cloud service should use "cloud".
TRACEIQ_DEPLOYMENT_MODE=self_hosted

# Authentication: "supabase" for accounts/teams/2FA, or "local" only for
# loopback-bound, single-user development. See compose.local.yml for local mode.
AUTH_MODE=supabase
NEXT_PUBLIC_AUTH_MODE=supabase

# ------------------------------------------------------------
# Database (Postgres on VPS)
# ------------------------------------------------------------
DATABASE_URL=postgresql://traceiq:traceiq@postgres:5432/traceiq?sslmode=disable
DATABASE_SSL=false

# ------------------------------------------------------------
# Redis (BullMQ queue)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------
# Supabase Auth (keep managed)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Session Replay object storage (private; replay is off by default)
# ------------------------------------------------------------
# Defaults: "filesystem" in self-hosted/local mode and "supabase" in Cloud.
# Set this explicitly in deployments so the intended backend is unambiguous.
REPLAY_STORAGE_DRIVER=filesystem
# Required only when REPLAY_STORAGE_DRIVER=supabase. Keep the service-role key
# server-only; never place it in a NEXT_PUBLIC_* variable.
REPLAY_STORAGE_BUCKET=session-replays
# Used only when REPLAY_STORAGE_DRIVER=filesystem. Mount it on persistent storage.
TRACEIQ_REPLAY_STORAGE_DIR=/var/lib/traceiq/session-replays
REPLAY_RETENTION_SWEEP_INTERVAL_MS=21600000
# Required for Cloud before replay can be enabled; use 32+ random characters.
# Set it in multi-instance self-hosted deployments so grants survive restarts.
REPLAY_UPLOAD_TOKEN_SECRET=
REPLAY_UPLOAD_TOKEN_SECONDS=300
REPLAY_STALE_UPLOAD_SECONDS=900
REPLAY_STORAGE_OPERATION_TIMEOUT_MS=30000
# Optional self-hosted safety ceilings (defaults shown).
REPLAY_MAX_REQUEST_BYTES=750000
REPLAY_MAX_COMPRESSED_CHUNK_BYTES=700000
REPLAY_MAX_UNCOMPRESSED_CHUNK_BYTES=2000000
REPLAY_MAX_EVENTS_PER_CHUNK=500
REPLAY_MAX_CHUNKS_PER_SESSION=3000
REPLAY_MAX_SESSION_BYTES=250000000
REPLAY_MAX_UNCOMPRESSED_SESSION_BYTES=250000000
REPLAY_MAX_PLAYBACK_PAGE_BYTES=8000000
REPLAY_MAX_DURATION_SECONDS=14400
REPLAY_MAX_CLOCK_SKEW_MS=300000

# ------------------------------------------------------------
# AI Gateway (Cencori - optional, degrades gracefully if missing)
# ------------------------------------------------------------
CENCORI_API_KEY=
TRACEIQ_AI_FAST_MODEL=
TRACEIQ_AI_REASONING_MODEL=
TRACEIQ_AI_TIMEOUT_MS=15000

# ------------------------------------------------------------
# External APIs (optional - degrade gracefully if missing)
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=TraceIQ Alerts <alerts@yourdomain.com>

# ------------------------------------------------------------
# CORS & API URLs
# ------------------------------------------------------------
CORS_ORIGINS=https://traceiq.run,https://www.traceiq.run
NEXT_PUBLIC_API_URL=https://api.traceiq.run

# ------------------------------------------------------------
# Dashboard (Vercel or VPS)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_WAITLIST_ONLY=false

# ------------------------------------------------------------
# API Port (internal)
# ------------------------------------------------------------
API_PORT=4000

# ------------------------------------------------------------
# Bachs billing (required only when TRACEIQ_DEPLOYMENT_MODE=cloud)
# ------------------------------------------------------------
# Sandbox: https://sandbox-api.bachs.io with an sk_sandbox_... key
# Production: https://api.bachs.io with an sk_live_... key
BACHS_API_BASE_URL=
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_PRO_MONTHLY_PRODUCT_ID=
BACHS_PRO_YEARLY_PRODUCT_ID=

# Optional sandbox E2E relay. Bachs requires a public HTTPS success URL, so a
# public test API can redirect back to the local signed-in dashboard.
# BILLING_DASHBOARD_RETURN_URL=http://localhost:3000
# BILLING_PUBLIC_API_URL=https://billing-test.traceiq.run

# Retention worker cadence. Defaults to every 6 hours; values below 60 seconds
# are clamped to protect the database.
RETENTION_SWEEP_INTERVAL_MS=21600000
BILLING_RECONCILIATION_INTERVAL_MS=21600000
