NODE_ENV=development
DATABASE_URL=postgresql://traceiq:traceiq@localhost:5432/traceiq
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
API_PORT=4000
NEXT_NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Alert email delivery via Resend. RESEND_FROM must be a verified sender domain.
RESEND_API_KEY=re_your-resend-key
RESEND_FROM=TraceIQ Alerts <alerts@traceiq.run>
# Origin of the dashboard used for email CTAs (e.g. "View achievements").
DASHBOARD_URL=http://localhost:3000
