{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@traceiq/shared": [
        "../../packages/shared/src"
      ],
      "@traceiq/types": [
        "../../packages/types/src"
      ],
      "@traceiq/ui": [
        "../../packages/ui/src"
      ],
      "@traceiq/sdk-js": [
        "../../packages/sdk-js/src"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
