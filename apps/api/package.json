{
  "name": "@traceiq/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-dist.js",
    "dev": "nest start --watch",
    "prebuild": "node scripts/clean-dist.js",
    "build": "nest build",
    "start": "node -e \"const fs = require('fs'); const p = fs.existsSync('dist/apps/api/src/main.js') ? './dist/apps/api/src/main.js' : './dist/main.js'; require(p);\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.js",
    "migrate:help": "node scripts/migrate.js --help",
    "migrate:status": "node scripts/migrate.js status",
    "digest": "node dist/digest.cli.js",
    "seed": "node scripts/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@traceiq/types": "0.1.0",
    "ajv": "8.12.0",
    "bullmq": "^5.12.10",
    "cencori": "^1.6.1",
    "cors": "^2.8.5",
    "pg": "^8.12.0",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "optionalDependencies": {
    "geoip-lite": "^1.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.12",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
