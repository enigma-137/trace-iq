{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@traceiq/shared": ["packages/shared/src"],
      "@traceiq/types": ["packages/types/src"],
      "@traceiq/ui": ["packages/ui/src"],
      "@traceiq/sdk-js": ["packages/sdk-js/src"]
    }
  }
}
