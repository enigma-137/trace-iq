{
	admin off
	email admin@traceiq.run
}

traceiq.run {
	reverse_proxy dashboard:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
}

api.traceiq.run {
	# Remote MCP server and its OAuth protected-resource metadata. The API itself
	# serves /.well-known/oauth-authorization-server and /oauth/*.
	@mcp path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @mcp {
		reverse_proxy mcp:8787 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy api:4000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}