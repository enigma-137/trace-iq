{
    "name": "traceiq/traceiq-php",
    "description": "TraceIQ server-side SDK for PHP — capture backend events with trustworthy properties.",
    "type": "library",
    "license": "MIT",
    "keywords": ["analytics", "events", "tracking", "traceiq"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TraceIQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TraceIQ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
